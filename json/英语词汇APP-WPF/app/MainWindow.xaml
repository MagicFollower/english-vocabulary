<Window x:Class="VocabDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StartUI4Controls;assembly=StartUI4Controls"
        xmlns:views="clr-namespace:VocabDesk.Views"
        Title="英语词汇检索" Width="1180" Height="760"
        MinWidth="{Binding ZoomFactor, Converter={StaticResource ZoomedSize}, ConverterParameter=W:820, FallbackValue=820}"
        MinHeight="{Binding ZoomFactor, Converter={StaticResource ZoomedSize}, ConverterParameter=H:520, FallbackValue=520}"
        Icon="AppIcon.ico"
        FontFamily="{DynamicResource UI4.Font.Family}"
        FontSize="{DynamicResource UI4.Font.Size.Base}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource UI4.Brush.Background}">

    <!-- 标题栏不要自绘：窗口里出现过 UI4 控件，库就在 Loaded 时按 DWM 把原生标题栏染好。 -->
    <!-- 全局缩放挂在根内容的 LayoutTransform 上；LayoutTransform 先把可用尺寸除以系数再交给子树，
         所以放大不裁切，只是可视设计像素变少——窗口下限跟着长（MinWidth/MinHeight 走 ZoomedSize 并钳到工作区）。
         已知边界：WPF 的 Popup（这里的检索模式下拉）住在自己的可视根里，不吃这层变换，
         非 100% 档下弹层内容仍按 100% 渲染。 -->

    <Window.Resources>
        <!-- 卡片模板必须住在这里：带事件处理器的 DataTemplate 的宿主类按"这段 XAML 所属的类"解析，
             放进 App.xaml 时宿主类是 App，本窗口的处理方法对不上。 -->

        <DataTemplate x:Key="PhraseRow">
            <TextBlock Text="{Binding}" Foreground="{DynamicResource UI4.Brush.TextMuted}"
                       TextWrapping="Wrap" Margin="12,0,0,0"
                       FontSize="{DynamicResource App.Font.Size.Small}"/>
        </DataTemplate>

        <DataTemplate x:Key="GlossRow">
            <TextBlock Text="{Binding}" Foreground="{DynamicResource UI4.Brush.Text}"
                       TextWrapping="Wrap" Margin="12,0,0,0"/>
        </DataTemplate>

        <DataTemplate x:Key="VariantGroup">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding Header}"
                           Foreground="{DynamicResource UI4.Brush.Accent}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource App.Font.Size.Caption}"/>
                <ItemsControl ItemsSource="{Binding Translations}" ItemTemplate="{StaticResource GlossRow}"/>
                <ItemsControl ItemsSource="{Binding Phrases}" ItemTemplate="{StaticResource PhraseRow}" Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- 展开/收起指示：折叠态是右指三角，选中（= 展开）态换成下指三角。
             状态只读容器的 IsSelected，与手风琴同一条通路，不另存一份布尔。 -->
        <Style x:Key="Chevron" TargetType="TextBlock">
            <Setter Property="Text" Value="&#x25B8;"/>
            <Setter Property="ToolTip" Value="展开 / 收起本条"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{DynamicResource UI4.Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="{DynamicResource App.Font.Size.Medium}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Text" Value="&#x25BE;"/>
                    <Setter Property="Foreground" Value="{DynamicResource UI4.Brush.Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="WordCard">
            <StackPanel Margin="16,12,16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Word}" FontWeight="Bold"
                                   FontSize="{DynamicResource App.Font.Size.Icon}"
                                   Foreground="{DynamicResource UI4.Brush.Text}"/>
                        <TextBlock Text="{Binding BookBadges}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource UI4.Brush.TextMuted}"
                                   FontSize="{DynamicResource App.Font.Size.Caption}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Chevron}" Margin="0,2,0,0"/>
                </Grid>

                <TextBlock Text="{Binding Summary}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource UI4.Brush.TextMuted}"/>

                <!-- 手风琴：展开态直接绑本项容器的 IsSelected，不另存一份状态。
                     单选列表里"同时展开数"因此恒为 1——这正是探针实测唯一安全的档
                     （N=1 maxGap 93–117 ms，N=12 就 428–487 ms 贴闸门，N=40 直接 1,334 ms）。
                     换检索结果或换书时，同一个 WordCard 实例若仍在新列表里，WPF 按项标识保留选中，
                     于是那张卡跟着过去（实测：全部→初中，"a" 仍是展开的那一张）——展开数还是 1。

                     ItemsSource 走 DataTrigger 而不是常绑：常绑时每个"被 realizing 的卡"都会在容器
                     换 DataContext 的那一刻求一次 {Binding Detail}，折叠着也照求。实测换书一次的
                     卡片列表重排：常绑 72.5 ms（最坏 152 ms），把 ItemsSource 换成 null 9.4 ms，
                     整个内层 ItemsControl 删掉 9.1 ms —— 说明那 63 ms 全在绑定求值上，不在控件本身。
                     放进"选中才赋值"的 Trigger 后，折叠卡根本不碰 Detail，展开那一张才建。 -->
                <ItemsControl ItemTemplate="{StaticResource VariantGroup}" Margin="0,8,0,0">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="ItemsSource" Value="{Binding Detail}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/>
        </Grid.LayoutTransform>

        <ui:UI4Grid>
            <!-- 间距全部落在 4 的倍数上；分组之间 ≥ 16，内容到边缘 20（同时给 UI4ListView 的
                 ShadowDepth 15 + ShadowBlurRadius 12 ≈ 27 留外溢，卡片 ItemMargin 也保住悬浮放大余量）。 -->
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶栏：检索框占余宽，模式与齿轮右对齐。齿轮是设置唯一入口。 -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:UI4TextBox x:Name="SearchBox" Grid.Column="0" Height="36"
                                   VerticalContentAlignment="Center"
                                   PlaceholderText="检索单词、短语或中文释义…"
                                   ShowClearButton="True"
                                   TextChanged="SearchBox_TextChanged"/>

                    <ui:UI4ComboBox x:Name="ModeBox" Grid.Column="1" Width="140" Height="36"
                                    Margin="12,0,0,0" VerticalAlignment="Top"
                                    SelectionChanged="ModeBox_SelectionChanged"/>

                    <ui:UI4Button x:Name="SettingsBtn" Grid.Column="2" HorizontalAlignment="Right"
                                  Margin="12,0,0,0"
                                  Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                  Width="{DynamicResource App.Size.RoundButton}"
                                  Height="{DynamicResource App.Size.RoundButton}"
                                  Padding="0" CornerRadius="{DynamicResource App.Radius.RoundButton}"
                                  FontSize="{DynamicResource App.Font.Size.Icon}"
                                  GradientStart="{DynamicResource UI4.Color.OffBackground}"
                                  GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                                  HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                                  ToolTip="设置（Esc 关闭）"
                                  Click="SettingsBtn_Click"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左栏按纯导航栏用：不给 Width 也不给 LeftPanelWidth——库在 LeftPanelWidth=NaN 时
                         让面板按项内容自适应，控件再贴着面板收口。实测过 MinWidth="150" 的坑：面板收到 95 px，
                         控件却被 MinWidth 撑到 150 px，右边就多出 54 px 的空带（看着像栏没对齐）。
                         所有导航项的 Content 一律留空，切换书只是换个数组引用（实测 6.7–20.9 ms）。 -->
                    <views:NavRail x:Name="Nav" Grid.Column="0" Header="词书"
                                          ItemFontSize="{DynamicResource UI4.Font.Size.Base}"
                                          ItemForeground="{DynamicResource UI4.Brush.Text}"
                                          ItemHoverColor="{DynamicResource UI4.Color.HoverOverlay}"
                                          ItemHoverForeground="{DynamicResource UI4.Color.TextForeground}"
                                          ItemPressedBackground="{DynamicResource UI4.Color.Surface}"
                                          ItemPressedForeground="{DynamicResource UI4.Color.TextForeground}"/>

                    <!-- 右区：结果卡片列表 + 加载遮罩 -->
                    <Grid Grid.Column="2">
                        <views:VirtualCardList x:Name="CardList"
                                               ItemsSource="{Binding Results}"
                                               ItemTemplate="{StaticResource WordCard}"
                                               IsSynchronizedWithCurrentItem="False"
                                               ShadowDepth="15" ShadowOpacity="0.2"
                                               ItemMargin="12" ItemPadding="0"
                                               HoverScale="1.01"
                                               PreviewMouseLeftButtonDown="CardList_PreviewMouseLeftButtonDown"
                                               PreviewMouseLeftButtonUp="CardList_PreviewMouseLeftButtonUp"
                                               SelectionChanged="CardList_SelectionChanged"
                                               VirtualizingStackPanel.IsVirtualizing="True"
                                               VirtualizingStackPanel.VirtualizationMode="Recycling"/>

                        <!-- 空结果提示：放在加载遮罩之前，加载期由遮罩盖住，只在"检索完但没命中"时露出来 -->
                        <TextBlock Text="没有命中的词头。换个检索模式（右侧下拉）或换个关键词再试。"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                                   Foreground="{DynamicResource UI4.Brush.TextMuted}"/>

                        <!-- 耗时界面：索引构建在后台线程跑（实测 1.30 s），这里给确定进度 + 阶段名。
                             构建期间 UI 帧间隙实测 ≤66 ms，动画不掉帧。 -->
                        <Border x:Name="BusyHost" Background="{DynamicResource UI4.Brush.Background}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                                <ui:UI4ProgressRing x:Name="BusyRing" Width="88" Height="88"
                                                    IsIndeterminate="True" ShowValueText="False"/>
                                <ui:UI4ProgressBar x:Name="BusyBar" Height="6" Maximum="1"
                                                   Value="{Binding BusyFraction}" Margin="0,20,0,0"/>
                                <TextBlock Text="{Binding BusyStage}" Margin="0,12,0,0"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <!-- 页脚左：当前视图与命中条数（加载失败/设置反馈也走这一句）；
                         页脚右：选中那个词的收录情况，没选中时是一句操作引导。 -->
                    <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource UI4.Brush.Icon}"/>
                    <TextBlock Text="{Binding SelectionSummary}" HorizontalAlignment="Right"
                               Foreground="{DynamicResource UI4.Brush.Icon}"/>
                </Grid>
            </Grid>
        </ui:UI4Grid>

        <!-- 设置浮层：遮罩吃掉点击，开合状态只有 IsSettingsOpen 一处 -->
        <Grid x:Name="SettingsHost" Panel.ZIndex="90"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Border Background="#80000000" MouseLeftButtonDown="SettingsOverlay_BackgroundClick"/>
            <Border Background="{DynamicResource UI4.Brush.Surface}"
                    BorderBrush="{DynamicResource UI4.Brush.BorderNormal}"
                    BorderThickness="1" CornerRadius="12" Padding="24"
                    Width="440" MaxHeight="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <views:SettingsOverlay DataContext="{Binding}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
