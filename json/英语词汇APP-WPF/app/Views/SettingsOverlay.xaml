<UserControl x:Class="VocabDesk.Views.SettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:StartUI4Controls;assembly=StartUI4Controls"
             xmlns:h="clr-namespace:VocabDesk.Helpers">
    <!-- 字号一律走层级键，不写字面数字：写字面数字的地方在用户调字号时不会跟着变。
         间距仍守 4 的倍数刻度（8 / 12 / 16 / 20 / 24）。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="设置" FontSize="{DynamicResource App.Font.Size.Icon}" FontWeight="SemiBold"
                       Foreground="{DynamicResource UI4.Brush.Text}" Margin="0,0,0,16"/>

            <!-- ① 应用信息：全部只读，排障时用得上（版本 / 运行时 / 组件库 / 设置目录 / 策略） -->
            <TextBlock Text="应用信息" FontSize="{DynamicResource App.Font.Size.Medium}" FontWeight="SemiBold"
                       Foreground="{DynamicResource UI4.Brush.Icon}" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="应用版本" Margin="0,4"
                           Foreground="{DynamicResource UI4.Brush.Icon}"
                           FontSize="{DynamicResource App.Font.Size.Small}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" Margin="0,4"
                           Foreground="{DynamicResource UI4.Brush.Text}"
                           FontSize="{DynamicResource App.Font.Size.Small}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="运行时" Margin="0,4"
                           Foreground="{DynamicResource UI4.Brush.Icon}"
                           FontSize="{DynamicResource App.Font.Size.Small}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeVersion}" Margin="0,4"
                           Foreground="{DynamicResource UI4.Brush.Text}"
                           FontSize="{DynamicResource App.Font.Size.Small}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="组件库" Margin="0,4"
                           Foreground="{DynamicResource UI4.Brush.Icon}"
                           FontSize="{DynamicResource App.Font.Size.Small}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LibraryVersion}" Margin="0,4"
                           Foreground="{DynamicResource UI4.Brush.Text}"
                           FontSize="{DynamicResource App.Font.Size.Small}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="明暗策略" Margin="0,4"
                           Foreground="{DynamicResource UI4.Brush.Icon}"
                           FontSize="{DynamicResource App.Font.Size.Small}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PolicyText}" Margin="0,4"
                           Foreground="{DynamicResource UI4.Brush.Text}"
                           FontSize="{DynamicResource App.Font.Size.Small}"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="设置目录" Margin="0,4"
                           Foreground="{DynamicResource UI4.Brush.Icon}"
                           FontSize="{DynamicResource App.Font.Size.Small}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SettingsFolder}" Margin="0,4"
                           Foreground="{DynamicResource UI4.Brush.Text}"
                           FontSize="{DynamicResource App.Font.Size.Small}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SettingsFolder}"/>
            </Grid>

            <Border Height="1" Background="{DynamicResource UI4.Brush.BorderNormal}" Margin="0,0,0,16"/>

            <!-- ② 配色：按钮写的是要点过去哪一档，当前档由设置单源决定，窗口上不再放第二个入口 -->
            <TextBlock Text="配色" FontSize="{DynamicResource App.Font.Size.Medium}" FontWeight="SemiBold"
                       Foreground="{DynamicResource UI4.Brush.Icon}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding ThemeChoices}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:UI4Button Content="{Binding Label}" CommandParameter="{Binding Key}"
                                      Command="{Binding DataContext.SelectThemeCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                      Height="{DynamicResource App.Size.Chip}" Padding="12,0"
                                      CornerRadius="{DynamicResource App.Radius.Chip}"
                                      FontSize="{DynamicResource App.Font.Size.Small}"
                                      Margin="0,0,8,8"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding AppliedThemeText}" Margin="0,0,0,16"
                       Foreground="{DynamicResource UI4.Brush.TextMuted}"
                       FontSize="{DynamicResource App.Font.Size.Caption}"/>

            <Border Height="1" Background="{DynamicResource UI4.Brush.BorderNormal}" Margin="0,0,0,16"/>

            <!-- ③ 字体：族 + 正文基准字号。层级由 Typography 派生，这里不摆每档字号的开关 -->
            <TextBlock Text="字体" FontSize="{DynamicResource App.Font.Size.Medium}" FontWeight="SemiBold"
                       Foreground="{DynamicResource UI4.Brush.Icon}" Margin="0,0,0,8"/>

            <TextBlock Text="字体族" Foreground="{DynamicResource UI4.Brush.Icon}"
                       FontSize="{DynamicResource App.Font.Size.Small}" Margin="0,0,0,4"/>
            <ui:UI4ComboBox Height="32" Margin="0,0,0,8"
                            ItemsSource="{Binding AvailableFonts}"
                            SelectedItem="{Binding SelectedFontFamily}">
                <ui:UI4ComboBox.ItemTemplate>
                    <DataTemplate>
                        <!-- 列表项是字体族名字符串；用该字体本身渲染，选中项与列表口径一致 -->
                        <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                    </DataTemplate>
                </ui:UI4ComboBox.ItemTemplate>
            </ui:UI4ComboBox>

            <TextBlock Foreground="{DynamicResource UI4.Brush.Icon}" Margin="0,0,0,4"
                       FontSize="{DynamicResource App.Font.Size.Small}">
                <TextBlock.Text>
                    <Binding Path="BaseFontSize" StringFormat="正文字号：{0:F0}"/>
                </TextBlock.Text>
            </TextBlock>
            <ui:UI4Slider Margin="0,0,0,8" IsValueVisible="True"
                          Minimum="{x:Static h:Typography.MinBaseSize}"
                          Maximum="{x:Static h:Typography.MaxBaseSize}"
                          Value="{Binding BaseFontSize}"/>

            <TextBlock Text="字号调的是正文基准，标题/标签/图标按固定层级跟随。"
                       Foreground="{DynamicResource UI4.Brush.TextMuted}" TextWrapping="Wrap"
                       FontSize="{DynamicResource App.Font.Size.Caption}" Margin="0,0,0,12"/>

            <ui:UI4Button Content="恢复默认字体与字号" HorizontalAlignment="Left" Margin="0,0,0,16"
                          Height="{DynamicResource App.Size.Chip}" Padding="12,0"
                          CornerRadius="{DynamicResource App.Radius.Chip}"
                          FontSize="{DynamicResource App.Font.Size.Small}"
                          GradientStart="{DynamicResource UI4.Color.OffBackground}"
                          GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                          HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                          Click="ResetTypography_Click"/>

            <Border Height="1" Background="{DynamicResource UI4.Brush.BorderNormal}" Margin="0,0,0,16"/>

            <!-- ④ 全局缩放：挂在根内容的 LayoutTransform 上，弹层不跟着放大是已知边界（见 README Step 4.5） -->
            <TextBlock Text="全局缩放" FontSize="{DynamicResource App.Font.Size.Medium}" FontWeight="SemiBold"
                       Foreground="{DynamicResource UI4.Brush.Icon}" Margin="0,0,0,8"/>
            <TextBlock Foreground="{DynamicResource UI4.Brush.Icon}" Margin="0,0,0,4"
                       FontSize="{DynamicResource App.Font.Size.Small}">
                <TextBlock.Text>
                    <Binding Path="ZoomPercent" StringFormat="缩放：{0:F0}%"/>
                </TextBlock.Text>
            </TextBlock>
            <ui:UI4Slider Margin="0,0,0,8" TickFrequency="10" IsValueVisible="True"
                          Minimum="{x:Static h:Typography.MinZoomPercent}"
                          Maximum="{x:Static h:Typography.MaxZoomPercent}"
                          Value="{Binding ZoomPercent}"/>

            <ui:UI4Button Content="恢复默认 (100%)" HorizontalAlignment="Left" Margin="0,0,0,12"
                          Height="{DynamicResource App.Size.Chip}" Padding="12,0"
                          CornerRadius="{DynamicResource App.Radius.Chip}"
                          FontSize="{DynamicResource App.Font.Size.Small}"
                          GradientStart="{DynamicResource UI4.Color.OffBackground}"
                          GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                          HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                          Click="ResetZoom_Click"/>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource UI4.Brush.TextMuted}"
                       TextWrapping="Wrap" FontSize="{DynamicResource App.Font.Size.Caption}"
                       Margin="0,0,0,12"/>

            <ui:UI4Button Content="完成" HorizontalAlignment="Right" Height="34" Padding="24,0"
                          CornerRadius="8" FontSize="{DynamicResource UI4.Font.Size.Base}"
                          GradientStart="{DynamicResource UI4.Color.Accent}"
                          GradientEnd="{DynamicResource UI4.Color.Accent}"
                          HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                          Click="Done_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
