{
  "name": "word-app",
  "productName": "WordStudy",
  "version": "1.0.0",
  "private": true,
  "description": "单词学习桌面应用：查询 / 学习 / 主页热力图",
  "main": "dist-electron/main.js",
  "scripts": {
    "ensure-electron": "install-electron",
    "dev": "node bin/dev.mjs",
    "build": "node bin/build.mjs",
    "dist": "node bin/build.mjs && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "reactbits": "node bin/fetch-reactbits.mjs",
    "reactbits:fetch": "node bin/fetch-reactbits.mjs --fetch-only",
    "reactbits:offline": "node bin/fetch-reactbits.mjs --offline",
    "sync-data": "node bin/sync-data.mjs",
    "sync-data:check": "node bin/sync-data.mjs --check",
    "test:study-overflow": "node bin/selftest.mjs --selftest-study",
    "test:all": "node bin/selftest.mjs"
  },
  "devDependencies": {
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "date-fns": "^4.4.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "gsap": "^3.15.0",
    "motion": "^14.0.0",
    "ogl": "^1.0.11",
    "react": "^19.3.0",
    "react-activity-calendar": "^3.2.1",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-window": "^2.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "zustand": "^5.0.15"
  }
}
